{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "https://stayhub-backend.onrender.com/api/:ruta*" },
    { "source": "/uploads/:ruta*", "destination": "https://stayhub-backend.onrender.com/uploads/:ruta*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
